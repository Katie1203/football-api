const assert=require('assert');const {decideLiveRung}=require('./live_rung_decision');const m={};const q=[{bookmakerId:1,overDecimal:1.55,line:2.5,observedAt:10}];const c=(id)=>({bookmakerId:id,marketMove:true,scoreChanged:false,lineDelta:0.25});assert.equal(decideLiveRung(m,{bookmakers:q,changes:[]}).level,null);assert.equal(decideLiveRung(m,{bookmakers:q,changes:[c(1)]}).level,'BET NHẸ TAY');assert.equal(decideLiveRung(m,{bookmakers:[{...q[0],overDecimal:1.49}],changes:[c(1)]}).level,null);assert.equal(decideLiveRung(m,{bookmakers:[],changes:[c(1),c(2)]}).level,'BIG BET');console.log('Decision unit tests passed');
