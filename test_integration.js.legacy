'use strict';
const assert=require('node:assert/strict');
const {parseResponse,malayToDecimal}=require('./bongdalu_type4');
const {LiveRungMarket}=require('./ai_live_rung_market');
const {decideLiveRung}=require('./live_rung_decision');
assert.equal(malayToDecimal(.5),1.5);
assert.equal(malayToDecimal(-.5),3);
assert.equal(malayToDecimal(0),null);
assert.deepEqual(parseResponse({ErrCode:1,Data:''}),[]);
const fields=Array(32).fill('');fields[0]='65';fields[1]='1';fields[2]='1';fields[21]='0.75';fields[22]='3';fields[23]='-0.95';fields[24]='0.75';fields[25]='3';fields[26]='-0.95';
const row=(book,line)=>{const f=[...fields];f[25]=String(line);return `3041387,${book},Book${book}#Live,0,0^${f.join(',')}`};
const feed={ErrCode:0,Data:[row(8,3),row(31,3)].join('!')};
assert.equal(parseResponse(feed).length,2);
const market=new LiveRungMarket();
assert.equal(market.observe('3041387',feed).bookmakers.length,2);
assert.equal(market.observe('3041387',feed).updates.length,0);
assert.equal(decideLiveRung({},market.get('3041387')).level,null);
const feed2={ErrCode:0,Data:[row(8,3.25),row(31,3.25)].join('!')};
assert.equal(market.observe('3041387',feed2).updates.length,2);
assert.equal(decideLiveRung({},market.get('3041387')).level,'BIG BET');
console.log('Parser, market and alert integration tests passed (synthetic fixtures)');
